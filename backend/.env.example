# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.

# MongoDB connection string (get a free one at https://cloud.mongodb.com)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/disaster-response?retryWrites=true&w=majority

# Secret key for signing JWT tokens — use a long random string in production
JWT_SECRET=replace_with_a_long_random_secret_string

# How long JWT tokens stay valid (e.g. 7d, 24h, 1h)
JWT_EXPIRES_IN=7d

# Port the backend server listens on
PORT=5000

# URL of the React frontend (used for CORS)
CLIENT_ORIGIN=http://localhost:3000
